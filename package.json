{
  "name": "edp-visualization",
  "version": "1.0.0",
  "private": true,
  "description": "SeaTunnel Zeta REST API V2 visualization console",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "npm --prefix web run dev",
    "dev:server": "node server/index.mjs",
    "build": "npm --prefix web run build",
    "start": "NODE_ENV=production node server/index.mjs",
    "setup": "npm install && npm --prefix web install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
